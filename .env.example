# VIOLET STUDIO API — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/violetstudio?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# ── BytePlus ModelArk ─────────────────────────────────────────────────────────
# Obtain from BytePlus console → ModelArk → API Keys
# NEVER expose these values in frontend code or logs.
# ARK_API_KEY matches the official SDK convention (github.com/volcengine/ark-runtime-go).
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# When set, every app model (violet-*) is sent to this BytePlus model. Leave empty to
# use each model's own mapping in apps/services/modelark/mapper.go. Must be one of:
# seedance-1-0-pro-250528, dreamina-seedance-2-0-fast-260128,
# dreamina-seedance-2-0-260128, dreamina-seedance-2-5-260628
ARK_DEFAULT_MODEL=seedance-1-0-pro-250528
ARK_REQUEST_TIMEOUT_SECONDS=300
ARK_POLL_INTERVAL_SECONDS=5

# Image generation uses an activated Seedream model, independently of video.
# Seedream 5.0 must be activated in the account used by the image API key.
ARK_IMAGE_MODEL=seedream-5-0-260128
# Optional image-only credentials/endpoint; empty values inherit ARK_API_KEY/ARK_BASE_URL.
ARK_IMAGE_API_KEY=
ARK_IMAGE_BASE_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Used for Supabase Storage (object storage) and JWT verification.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Object Storage (for persisting generated media) ──────────────────────────
# Required: generated videos are copied here because BytePlus URLs expire after 24h.
# Only supabase is implemented; it needs SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and a
# private bucket named by STORAGE_BUCKET.
# STORAGE_PROVIDER=supabase|s3|gcs|byteplus-tos
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=violet-media
# Create this separate private bucket in the same Supabase project. Never rename
# STORAGE_BUCKET to move existing objects: legacy keys continue using that bucket.
STORAGE_IMAGE_BUCKET=violet-characters
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_BASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Sharing ───────────────────────────────────────────────────────────────────
# Frontend origin used to build share links: <PUBLIC_WEB_BASE_URL>/s/<token>
PUBLIC_WEB_BASE_URL=http://localhost:3000
# Unauthenticated requests (/public/v1) allowed per client IP per minute
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_JOBS_PER_MINUTE=10
MAX_CONCURRENT_JOBS_PER_USER=3

# Dev only — fixed userID when auth middleware is disabled
# Set to a real UUID from users table; ignored when JWTAuth is active
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Optional vision-capable ModelArk model/endpoint; no default. Required only for character reference description.
ARK_REFERENCE_ANALYSIS_MODEL=
# Empty credentials/base URL fall back to ARK_IMAGE_* (then ARK_*).
ARK_REFERENCE_ANALYSIS_API_KEY=
ARK_REFERENCE_ANALYSIS_BASE_URL=

# Story Flow: explicitly configure an activated text/chat analysis model; no model default.
ARK_STORY_ANALYSIS_MODEL=
# Optional analysis-specific credentials/base URL; blank uses existing analysis/image/ARK fallback.
ARK_STORY_ANALYSIS_API_KEY=
ARK_STORY_ANALYSIS_BASE_URL=

# Director (/studio/director). Story planning provider: gemini|modelark.
# Blank selects gemini when ARK_STORY_ANALYSIS_MODEL is empty and GEMINI_API_KEY is set
# (uses GEMINI_MODEL); otherwise modelark with ARK_STORY_ANALYSIS_MODEL.
# Storyboard images use ARK_IMAGE_MODEL. Shot videos use the video menu models and ARK_API_KEY.
DIRECTOR_STORY_PROVIDER=
DIRECTOR_STORY_POINTS=4
DIRECTOR_IMAGE_POINTS=3
DIRECTOR_VIDEO_POINTS=20
# Seedance 2.5 draft (480p preview) price per shot; 0 disables draft mode.
DIRECTOR_VIDEO_DRAFT_POINTS=8
# Character reference images sent per storyboard image (others are described in text).
# 0 = text-only like Character Studio. Each referenced character keeps its face and outfit better.
DIRECTOR_IMAGE_MAX_REFERENCES=4
# Optional Seedance human_face_mode for Director video ("strict" | "relaxed"); blank = not sent.
# Unverified against live behaviour: try "relaxed" if realistic storyboard frames are rejected as real faces.
DIRECTOR_VIDEO_HUMAN_FACE_MODE=
# Optional public base URL holding cinematic.jpg, anime.jpg, 3d.jpg, watercolor.jpg, clay.jpg, realistic.jpg.
DIRECTOR_SAMPLE_BASE_URL=

# AI editor phase 2 (server only). Disabled until all local dependencies are configured.
EDITOR_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Explicit cache generation; bump when changing the deployed provider/model revision.
GEMINI_MODEL_VERSION=
# Local ASR provider: whisper (existing default) or typhoon (Thai ONNX CPU).
EDITOR_ASR_PROVIDER=whisper
TYPHOON_PYTHON=
TYPHOON_RUNNER=scripts/typhoon/transcribe.py
TYPHOON_MODEL_PATH=
TYPHOON_MODEL_VERSION=
WHISPER_PYTHON=
WHISPER_RUNNER=scripts/whisper/transcribe.py
WHISPER_MODEL_PATH=
WHISPER_MODEL_VERSION=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=

# ── FFmpeg text overlays ──────────────────────────────────────────────────────
# Font file used by FFmpeg drawtext for storyboard and video-editor text. The
# default DejaVuSans has NO Thai glyphs: the video editor reports
# textOverlays=false and refuses text exports (503 MEDIA_UNAVAILABLE) until this
# points at a Thai-capable TTF/OTF/TTC, e.g. Alpine `font-noto-thai`
# (/usr/share/fonts/noto/NotoSansThai-Regular.ttf), Debian `fonts-thai-tlwg`, or on
# macOS /System/Library/Fonts/Supplemental/Ayuthaya.ttf. FFmpeg must also be
# built with the drawtext filter (libfreetype; libharfbuzz for Thai mark shaping).
FFMPEG_FONT_FILE=/usr/share/fonts/dejavu/DejaVuSans.ttf
