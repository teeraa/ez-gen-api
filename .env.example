# VIOLET STUDIO API — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/violetstudio?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# ── BytePlus ModelArk ─────────────────────────────────────────────────────────
# Obtain from BytePlus console → ModelArk → API Keys
# NEVER expose these values in frontend code or logs.
# ARK_API_KEY matches the official SDK convention (github.com/volcengine/ark-runtime-go).
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# When set, every app model (violet-*) is sent to this BytePlus model. Leave empty to
# use each model's own mapping in apps/services/modelark/mapper.go. Must be one of:
# seedance-1-0-pro-250528, dreamina-seedance-2-0-fast-260128,
# dreamina-seedance-2-0-260128, dreamina-seedance-2-5-260628
ARK_DEFAULT_MODEL=seedance-1-0-pro-250528
ARK_REQUEST_TIMEOUT_SECONDS=300
ARK_POLL_INTERVAL_SECONDS=5

# ── Supabase ──────────────────────────────────────────────────────────────────
# Used for Supabase Storage (object storage) and JWT verification.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Object Storage (for persisting generated media) ──────────────────────────
# Required: generated videos are copied here because BytePlus URLs expire after 24h.
# Only supabase is implemented; it needs SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and a
# private bucket named by STORAGE_BUCKET.
# STORAGE_PROVIDER=supabase|s3|gcs|byteplus-tos
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=violet-media
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_BASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_JOBS_PER_MINUTE=10
MAX_CONCURRENT_JOBS_PER_USER=3

# Dev only — fixed userID when auth middleware is disabled
# Set to a real UUID from users table; ignored when JWTAuth is active
DEV_USER_ID=00000000-0000-0000-0000-000000000001
